<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="permission.user.grid.columnSet">
            <block class="Magento\Backend\Block\Widget\Grid\Column" name="permission.user.grid.columnSet.websites" as="websites">
                <arguments>
                    <argument name="header" xsi:type="string" translate="true">Websites/Groups/Stores</argument>
                    <argument name="type" xsi:type="string">text</argument>
                    <argument name="index" xsi:type="string">websites</argument>
                    <argument name="filter" xsi:type="boolean">false</argument>
                    <argument name="renderer" xsi:type="string">Dulv\SeparateAdminUser\Ui\Component\Listing\User\RenderGridWebsites</argument>
                    <argument name="column_css_class" xsi:type="string">col-status</argument>
                    <argument name="header_css_class" xsi:type="string">col-status</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
